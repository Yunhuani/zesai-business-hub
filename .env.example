# Zesai Business Hub environment template
# Copy this file to .env for local development.
# Never commit .env or real secrets.

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
# Required. Use development locally, production in deployed builds.
NODE_ENV=development

# Optional. Express HTTP port. Defaults to 3000.
PORT=3000

# Optional. App id used by the frontend and OAuth/session helpers.
VITE_APP_ID=zesai-ai

# Optional. Browser page title/brand override.
VITE_APP_TITLE=ZESI AI

# Optional. Public app URL used for referral links and callbacks.
VITE_APP_URL=http://localhost:3000

# Optional. OAuth portal base URL when OAuth login is enabled.
VITE_OAUTH_PORTAL_URL=https://example.com/oauth

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Required. MySQL-compatible database URL.
# Use a local or isolated test database for development. Do not use production.
DATABASE_URL=mysql://zesai_test:zesai_test_password@127.0.0.1:3306/zesai_business_hub_test

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Required. Strong random secret for JWT and cookie signing.
# Generate locally with: openssl rand -base64 48
JWT_SECRET=replace-with-strong-random-local-secret

# Optional. OAuth server URL for platform OAuth login.
OAUTH_SERVER_URL=https://example.com

# Optional. OpenId that should receive admin role on OAuth upsert.
OWNER_OPEN_ID=owner-open-id

# ------------------------------------------------------------
# LLM provider
# ------------------------------------------------------------
# Required for AI chat/model calls.
# Supported providers in server/_core/env.ts: openrouter, moonshot, anthropic, openai.
LLM_PROVIDER=openrouter

# Required for AI chat/model calls.
LLM_API_KEY=replace-with-provider-api-key

# Required for AI chat/model calls.
LLM_MODEL=deepseek-v4-flash

# Optional. Custom OpenAI-compatible base URL.
# Example for DeepSeek direct access: https://api.deepseek.com
LLM_BASE_URL=

# ------------------------------------------------------------
# NBG diagnosis engine
# ------------------------------------------------------------
# Optional. Defaults to http://localhost:8000.
NBG_ENGINE_URL=http://localhost:8000

# ------------------------------------------------------------
# Email / password reset
# ------------------------------------------------------------
# Required if password reset or email verification is used.
# Current mail sender uses smtp.exmail.qq.com:465 in server/_core/email.ts.
SMTP_USER=replace-with-smtp-login
SMTP_PASS=replace-with-smtp-password-or-app-password

# ------------------------------------------------------------
# Payments
# ------------------------------------------------------------
# Optional unless Alipay is enabled.
ALIPAY_APP_ID=replace-with-alipay-app-id
ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nreplace-with-private-key\n-----END RSA PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-public-key\n-----END PUBLIC KEY-----

# Optional unless WeChat login/pay is enabled.
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCHID=replace-with-wechat-pay-merchant-id
WECHAT_PAY_API_V3_KEY=replace-with-wechat-pay-api-v3-key

# ------------------------------------------------------------
# SMS
# ------------------------------------------------------------
# Optional unless SMS login/register/bind is enabled.
ALIYUN_SMS_ACCESS_KEY_ID=replace-with-aliyun-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=replace-with-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=replace-with-sms-sign-name
ALIYUN_SMS_TEMPLATE_CODE=replace-with-sms-template-code

# ------------------------------------------------------------
# Storage / forge compatibility
# ------------------------------------------------------------
# Optional compatibility variables for older storage/map integrations.
BUILT_IN_FORGE_API_URL=https://example.com/forge
BUILT_IN_FORGE_API_KEY=replace-with-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://example.com/forge
VITE_FRONTEND_FORGE_API_KEY=replace-with-frontend-forge-api-key

# ------------------------------------------------------------
# Observability and alerts
# ------------------------------------------------------------
# Optional. Backend Sentry.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development

# Optional. Frontend Sentry.
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_ENVIRONMENT=development

# Optional. Ops alert webhook and ServerChan key.
OPS_ALERT_WEBHOOK=https://example.com/webhook
SERVERCHAN_KEY=replace-with-serverchan-key
