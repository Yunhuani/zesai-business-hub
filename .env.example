# ========================================
# 泽思AI商业智库 - 环境变量配置
# 复制此文件为 .env 并填入你的配置
# ========================================

# ========================================
# AI 模型配置（关键）
# ========================================

# Provider 选择：openrouter | moonshot | anthropic | openai
# 推荐使用 openrouter（支持一键切换多个模型）
LLM_PROVIDER=openrouter

# API Key
# OpenRouter: https://openrouter.ai/keys
# Kimi: https://platform.moonshot.cn/console/api-keys
LLM_API_KEY=your-api-key-here

# 模型选择（根据 Provider 选择对应的模型ID）
# OpenRouter 推荐模型：
#   - anthropic/claude-3.5-sonnet (推荐，商业咨询最佳)
#   - openai/gpt-4o
#   - google/gemini-pro
#   - deepseek/deepseek-chat
# Moonshot 模型：
#   - moonshot-v1-8k
#   - moonshot-v1-32k
#   - moonshot-v1-128k
LLM_MODEL=anthropic/claude-3.5-sonnet

# 可选：自定义 API Base URL
# 如果留空，会根据 LLM_PROVIDER 自动使用默认地址
# LLM_BASE_URL=


# ========================================
# 数据库配置
# ========================================

# PostgreSQL 数据库（迁移后使用）
# Neon: https://neon.tech
# Supabase: https://supabase.com
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@host:5432/zesai


# ========================================
# 认证配置
# ========================================

# JWT 密钥（用于用户登录认证）
# 生成随机字符串：openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here


# ========================================
# 支付配置
# ========================================

# 支付宝配置
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# 微信支付（可选）
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret
# WECHAT_PAY_ENABLED=false

# Stripe（可选，国际支付）
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx


# ========================================
# 其他配置
# ========================================

# 应用ID（可选）
VITE_APP_ID=zesai-ai

# 环境设置
NODE_ENV=production

# 管理员通知（可选）
# OWNER_OPEN_ID=your-open-id


# ========================================
# 切换模型示例
# ========================================

# 示例1：使用 OpenRouter + DeepSeek（当前可用，性价比高）
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-xxx
# LLM_MODEL=deepseek/deepseek-chat

# 示例2：使用 OpenRouter + Claude（如可用）
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-xxx
# LLM_MODEL=anthropic/claude-3.5-sonnet-20241022

# 示例3：使用 Kimi 直连
# LLM_PROVIDER=moonshot
# LLM_API_KEY=sk-xxx
# LLM_MODEL=moonshot-v1-32k

# 示例4：使用 Anthropic 直连
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxx
# LLM_MODEL=claude-3-5-sonnet-20241022
